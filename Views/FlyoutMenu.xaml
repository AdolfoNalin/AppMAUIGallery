<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage
    x:Class="AppMAUIGallery.Views.FlyoutMenu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppMAUIGallery.Views"
    Title="FlyoutMenu"
    FlyoutLayoutBehavior="Popover">

    <FlyoutPage.Flyout>
        <views:Menu />
    </FlyoutPage.Flyout>
    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <views:MainPage />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>
