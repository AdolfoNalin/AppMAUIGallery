<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppMAUIGallery.Views.Layouts.AbsoluteLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="AbsoluteLayoutPage">

    <AbsoluteLayout >
        <Label
            AbsoluteLayout.LayoutBounds="50,0, 50, 50"
            BackgroundColor="NavajoWhite"
            Text="Olá mundo"
            TextColor="Black" />

        <Button
            AbsoluteLayout.LayoutBounds="0.5,0.5,200,60"
            AbsoluteLayout.LayoutFlags="PositionProportional"
            Text="Clique em mim" />

        <BoxView AbsoluteLayout.LayoutBounds="150,200,50,50" Color="Red" />
        <BoxView AbsoluteLayout.LayoutBounds="175,225,50,50" Color="Green" />
        <BoxView AbsoluteLayout.LayoutBounds="200,250,50,50" Color="Blue" />
        <BoxView AbsoluteLayout.LayoutBounds="225,275,50,50" Color="Gray" />
        <BoxView AbsoluteLayout.LayoutBounds="250,300,50,50" Color="Aqua" />
    </AbsoluteLayout>
</ContentPage>