<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppMAUIGallery.Views.Layouts.GridLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="GridLayoutPage">

    <Grid
        Margin="20"
        Padding="10"
        BackgroundColor="White"
        ColumnDefinitions="6*, Auto, 2*, 2*"
        ColumnSpacing="10"
        RowDefinitions="50, 100, *"
        RowSpacing="10">

        <BoxView Color="Aquamarine" />
        <Label
            HorizontalOptions="Center"
            Text="Olá mundo"
            VerticalOptions="Center" />

        <BoxView
            Grid.Row="0"
            Grid.Column="1"
            WidthRequest="50"
            Color="ForestGreen" />

        <BoxView
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            Color="Blue" />

        <Label
            Grid.RowSpan="2"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            HorizontalOptions="Center"
            Text="Olá mundo"
            VerticalOptions="Center" />

        <BoxView Grid.Row="1" Color="Orange" />

        <BoxView
            Grid.Row="1"
            Grid.Column="1"
            Color="Red" />

        <BoxView
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HeightRequest="10"
            Color="Black" />
    </Grid>
</ContentPage>